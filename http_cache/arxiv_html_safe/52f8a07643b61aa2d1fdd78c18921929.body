  <li class="arxiv-result">
    <div class="is-marginless">
      <p class="list-title is-inline-block"><a href="https://arxiv.org/abs/2606.16751">arXiv:2606.16751</a>
        <span>&nbsp;[<a href="https://arxiv.org/pdf/2606.16751">pdf</a>, <a href="https://arxiv.org/ps/2606.16751">ps</a>, <a href="https://arxiv.org/format/2606.16751">other</a>]&nbsp;</span>
