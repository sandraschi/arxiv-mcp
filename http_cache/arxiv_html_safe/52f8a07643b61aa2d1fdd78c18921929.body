        <span>&nbsp;[<a href="https://arxiv.org/pdf/2606.16527">pdf</a>, <a href="https://arxiv.org/ps/2606.16527">ps</a>, <a href="https://arxiv.org/format/2606.16527">other</a>]&nbsp;</span>
