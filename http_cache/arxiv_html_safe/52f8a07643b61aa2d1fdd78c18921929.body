    <p class="title is-5 mathjax">
      
        <span class="search-hit mathjax">Jailbreaking</span> Multimodal Large Language Models using Multi-Clip Video
      
    </p>
    <p class="authors">
      <span class="has-text-black-bis has-text-weight-semibold">Authors:</span>
      
      <a href="/search/?searchtype=author&amp;query=Kang%2C+C">Choongwon Kang</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Sun%2C+S">Seungjong Sun</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Jun%2C+H">Hyunmin Jun</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Kim%2C+J+H">Jang Hyun Kim</a>
      
