      <a href="/search/?searchtype=author&amp;query=Liu%2C+C">Chien-Feng Liu</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Chang%2C+Y">You-Hsuan Chang</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Chen%2C+Y">Yun-Nung Chen</a>
      
