      <a href="/search/?searchtype=author&amp;query=Dias%2C+G+N">Guilherme Nielsen Dias</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Berto%2C+M+W+P">Marccello Wilson Perez Berto</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Von+Atzingen%2C+G+V">Gustavo Voltani Von Atzingen</a>
      
