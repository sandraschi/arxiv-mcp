      <a href="/search/?searchtype=author&amp;query=Ji%2C+H">Haoxuan Ji</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Huang%2C+Y">Yuzhe Huang</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Gao%2C+H">Haichang Gao</a>
      
