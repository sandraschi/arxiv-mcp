<th class="ltx_td ltx_th ltx_th_column ltx_border_tt" id="S3.T5.5.6.1.2"></th>
<th class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" id="S3.T5.5.6.1.3"><span class="ltx_text" id="S3.T5.5.6.1.3.1" style="font-size:70%;">Pass@16</span></th>
