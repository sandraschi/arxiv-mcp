stnumberx12.29"> </span>*<span class="ltx_text ltx_lst_space" id="lstnumberx12.30"> </span><span class="ltx_text ltx_lst_identifier" id="lstnumberx12.31">Real</span>.<span class="ltx_text ltx_lst_identifier" id="lstnumberx12.32">pi</span><span class="ltx_text ltx_lst_space" id="lstnumberx12.33"> </span>/<span class="ltx_text ltx_lst_space" id="lstnumberx12.34"> </span>7)<span class="ltx_text ltx_lst_space" id="lstnumberx12.35"> </span>=<span class="ltx_text ltx_lst_space" id="lstnumberx12.36"> </span>1<span class="ltx_text ltx_lst_space" id="lstnumberx12.37"> </span>/<span class="ltx_text ltx_lst_space" id="lstnumberx12.38"> </span>2<span class="ltx_text ltx_lst_space" id="lstnumberx12.39"> </span>:=<span class="ltx_text ltx_lst_space" id="lstnumberx12.40"> </span><span class="ltx_text ltx_lst_identifier" id="lstnumberx12.41">by</span>
