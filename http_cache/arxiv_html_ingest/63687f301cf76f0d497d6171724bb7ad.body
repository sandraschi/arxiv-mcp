.18.18.2.m1.1.1.3.2.cmml" type="float" xref="S3.T2.18.18.18.2.m1.1.1.3.2">88.9</cn></apply></apply></annotation-xml><annotation encoding="application/x-tex" id="S3.T2.18.18.18.2.m1.1c">\mathbf{217/244=88.9\%}</annotation><annotation encoding="application/x-llamapun" id="S3.T2.18.18.18.2.m1.1d">bold_217 / bold_244 = bold_88.9 %</annotation></semantics></math></td>
