tx_text" id="lstnumberx1150.70" style="font-size:80%;">.</span><span class="ltx_text ltx_lst_identifier" id="lstnumberx1150.71" style="font-size:80%;">degree</span><span class="ltx_text ltx_lst_space" id="lstnumberx1150.72" style="font-size:80%;"> </span><span class="ltx_text" id="lstnumberx1150.73" style="font-size:80%;">&gt;</span><span class="ltx_text ltx_lst_space" id="lstnumberx1150.74" style="font-size:80%;"> </span><span class="ltx_text ltx_lst_identifier" id="lstnumberx1150.75" style="font-size:80%;">Q</span><span class="ltx_text" id="lstnumberx1150.76" style="font-size:80%;">.</span><span class="ltx_text ltx_lst_identifier" id="lstnumberx1150.77" style="font-size:80%;">degree</span><span class="ltx_text ltx_lst_space" id="lstnumberx1150.78" style="font-size:80%;"> </span><span class="ltx_text" id="lstnumberx1150.79" style="font-size:80%;">}.</span><span class="ltx_text ltx_lst_identifier" id="lstnumberx1150.80" style="font-size:80%;">ncard</span><span class="ltx_text ltx_lst_space" id="lstnumberx1150.81" style="font-size:80%;"> </span><span class="ltx_text" id="lstnumberx1150.82" style="font-size:80%;">:</span><span class="ltx_text ltx_lst_space" id="lstnumberx1150.83" style="font-size:80%;"> </span><span class="ltx_text" id="lstnumberx1150.84" style="font-size:80%;">ℕ)</span><span class="ltx_text ltx_lst_space" id="lstnumberx1150.85" style="font-size:80%;"> </span><span class="ltx_text" id="lstnumberx1150.86" style="font-size:80%;">=</span><span class="ltx_text ltx_lst_space" id="lstnumberx1150.87" style="font-size:80%;"> </span><span class="ltx_text" id="lstnumberx1150.88" style="font-size:80%;">2</span><span class="ltx_text ltx_lst_space" id="lstnumberx1150.89" style="font-size:80%;"> </span><span class="ltx_text" id="lstnumberx1150.90" style="font-size:80%;">^</span><span class="ltx_text ltx_lst_space" id="lstnumberx1150.91" style="font-size:80%;"> </span><span class="ltx_text" id="lstnumberx1150.92" style="font-size:80%;">(</span><span class="ltx_text ltx_lst_identifier" id="lstnumberx1150.93" style="font-size:80%;">n</span><span class="ltx_text ltx_lst_space" id="lstnumberx1150.94" style="font-size:80%;"> </span><span class="ltx_text" id="lstnumberx1150.95" style="font-size:80%;">+</span><span class="ltx_text ltx_lst_space" id="lstnumberx1150.96" style="font-size:80%;"> </span><span class="ltx_text" id="lstnumberx1150.97" style="font-size:80%;">1)</span><span class="ltx_text ltx_lst_space" id="lstnumberx1150.98" style="font-size:80%;"> </span><span class="ltx_text" id="lstnumberx1150.99" style="font-size:80%;">:=</span><span class="ltx_text ltx_lst_space" id="lstnumberx1150.100" style="font-size:80%;"> </span><span class="ltx_text ltx_lst_identifier" id="lstnumberx1150.101" style="font-size:80%;">by</span>
