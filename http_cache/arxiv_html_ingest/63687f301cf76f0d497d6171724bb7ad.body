x_lst_space" id="lstnumberx1159.29"> </span>:=
</div>
<div class="ltx_listingline" id="lstnumberx1160">
<span class="ltx_text ltx_lst_space" id="lstnumberx1160.1"> </span>∃<span class="ltx_text ltx_lst_space" id="lstnumberx1160.2"> </span><span class="ltx_text ltx_lst_identifier" id="lstnumberx1160.3">k</span>,<span class="ltx_text ltx_lst_space" id="lstnumberx1160.4"> </span>∀<span class="ltx_text ltx_lst_space" id="lstnumberx1160.5"> </span><span class="ltx_text ltx_lst_identifier" id="lstnumberx1160.6">i</span><span class="ltx_text ltx_lst_space" id="lstnumberx1160.7"> </span>:<span class="ltx_text ltx_lst_space" id="lstnumberx1160.8"> </span><span class="ltx_text ltx_lst_identifier" id="lstnumberx1160.9">Fin</span><span class="ltx_text ltx_lst_space" id="lstnumberx1160.10"> </span><span class="ltx_text ltx_lst_identifier" id="lstnumberx1160.11">U</span>.1,<span class="ltx_text ltx_lst_space" id="lstnumberx1160.12"> </span><span class="ltx_text ltx_lst_identifier" id="lstnumberx1160.13">U</span>.2<span class="ltx_text ltx_lst_space" id="lstnumberx1160.14"> </span><span class="ltx_text ltx_lst_identifier" id="lstnumberx1160.15">i</span><span class="ltx_text ltx_lst_space" id="lstnumberx1160.16"> </span>=<span class="ltx_text ltx_lst_space" id="lstnumberx1160.17"> </span><span class="ltx_text ltx_lst_identifier" id="lstnumberx1160.18">W</span><span class="ltx_text ltx_lst_space" id="lstnumberx1160.19"> </span>(<span class="ltx_text ltx_lst_identifier" id="lstnumberx1160.20">k</span><span class="ltx_text ltx_lst_space" id="lstnumberx1160.21"> </span>+<span class="ltx_text ltx_lst_space" id="lstnumberx1160.22"> </span><span class="ltx_text ltx_lst_identifier" id="lstnumberx1160.23">i</span>)
</div>
<div class="ltx_listingline" id="lstnumberx1161">
</div>
<div class="ltx_listingline" id="lstnumberx1162">
<span class="ltx_text ltx_lst_identifier" id="lstnumberx1162.1">def</span><span class="ltx_text ltx_lst_space" id="lstnumberx1162.2"> </span><span class="ltx_text ltx_lst_identifier" id="lstnumberx1162.3">ubiquitous</span><span class="ltx_text ltx_lst_space" id="lstnumberx1162.4"> </span>(<span class="ltx_text ltx_lst_identifier" id="lstnumberx1162.5">W</span><span class="ltx_text ltx_lst_space" id="lstnumberx1162.6"> </span>:<span class="ltx_text ltx_lst_space" id="lstnumberx1162.7"> </span>ℤ<span class="ltx_text ltx_lst_space" id="lstnumberx1162.8"> </span>→<span class="ltx_text ltx_lst_space" id="lstnumberx1162.9"> </span><span class="ltx_text ltx_lst_identifier" id="lstnumberx1162.10">Fin</span><span class="ltx_text ltx_lst_space" id="lstnumberx1162.11"> </span>2)<span class="ltx_text ltx_lst_space" id="lstnumberx1162.12"> </span>(<span class="ltx_text ltx_lst_identifier" id="lstnumberx1162.13">U</span><span class="ltx_text ltx_lst_space" id="lstnumberx1162.14"> </span>:<span class="ltx_text ltx_lst_space" id="lstnumberx1162.15"> </span>Σ<span class="ltx_text ltx_lst_space" id="lstnumberx1162.16"> </span><span class="ltx_text ltx_lst_identifier" id="lstnumberx1162.17">n</span>,<span class="ltx_text ltx_lst_space" id="lstnumberx1162.18"> </span><span class="ltx_text ltx_lst_identifier" id="lstnumberx1162.19">Fin</span><span class="ltx_text ltx_lst_space" id="lstnumberx1162.20"> </span><span class="ltx_text ltx_lst_identifier" id="lstnumberx1162.21">n</span><span class="ltx_text ltx_lst_space" id="lstnumberx1162.22"> </span>→<span class="ltx_text ltx_lst_space" id="lstnumberx1162.23"> </span><span class="ltx_text ltx_lst_identifier" id="lstnumberx1162.24">Fin</span><span class="ltx_text ltx_lst_space" id="lstnumberx1162.25"> </span>2)<span class="ltx_text ltx_lst_space" id="lstnumberx1162.26"> </span>:<span class="ltx_text ltx_lst_space" id="lstnumberx1162.27"> </span><span class="ltx_text ltx_lst_identifier" id="lstnumberx1162.28">Prop</span><span class="ltx_text ltx_lst_space" id="lstnumberx1162.29"> </span>:=
</div>
<div class="ltx_listingline" id="lstnumberx1163">
<span class="ltx_text ltx_lst_space" id="lstnumberx1163.1"> </span><span class="ltx_text ltx_lst_identifier" id="lstnumberx1163.2">appears</span><span class="ltx_text ltx_lst_space" id="lstnumberx1163.3"> </span><span class="ltx_text ltx_lst_identifier" id="lstnumberx1163.4">W</span><span class="ltx_text ltx_lst_space" id="lstnumberx1163.5"> </span>⟨<span class="ltx_text ltx_lst_identifier" id="lstnumberx1163.6">U</span>.1<span class="ltx_text ltx_lst_space" id="lstnumberx1163.7"> </span>+<span class="ltx_text ltx_lst_space" id="lstnumberx1163.8"> </span>1,<span class="ltx_text ltx_lst_space" id="lstnumberx1163.9"> </span><span class="ltx_text ltx_lst_identifier" id="lstnumberx1163.10">Fin</span>.<span class="ltx_text ltx_lst_identifier" id="lstnumberx1163.11">snoc</span><span class="ltx_text ltx_lst_space" id="lstnumberx1163.12"> </span><span class="ltx_text ltx_lst_identifier" id="lstnumberx1163.13">U</span>.2<span class="ltx_text ltx_lst_space" id="lstnumberx1163.14"> </span>0⟩<span class="ltx_text ltx_lst_space" id="lstnumberx1163.15"> </span>∧
</div>
<div class="ltx_listingline" id="lstnumberx1164">
<span class="ltx_text ltx_lst_space" id="lstnumberx1164.1"> </span><span class="ltx_text ltx_lst_identifier" id="lstnumberx1164.2">appears</span><span class="ltx_text ltx_lst_space" id="lstnumberx1164.3"> </span><span class="ltx_text ltx_lst_identifier" id="lstnumberx1164.4">W</span><span class="ltx_text ltx_lst_space" id="lstnumberx1164.5"> </span>⟨<span class="ltx_text ltx_lst_identifier" id="lstnumberx1164.6">U</span>.1<span class="ltx_text ltx_lst_space" id="lstnumberx1164.7"> </span>+<span class="ltx_text ltx_lst_space" id="lstnumberx1164.8"> </span>1,<span class="ltx_text ltx_lst_space" id="lstnumberx1164.9"> </span><span class="ltx_text ltx_lst_identifier" id="lstnumberx1164.10">Fin</span>.<span class="ltx_text ltx_lst_identifier" id="lstnumberx1164.11">snoc</span><span class="ltx_text ltx_lst_space" id="lstnumberx1164.12"> </span><span class="ltx_text ltx_lst_identifier" id="lstnumberx1164.13">U</span>.2<span class="ltx_text ltx_lst_space" id="lstnumberx1164.14"> </span>1⟩<span class="ltx_text ltx_lst_space" id="lstnumberx1164.15"> </span>∧
