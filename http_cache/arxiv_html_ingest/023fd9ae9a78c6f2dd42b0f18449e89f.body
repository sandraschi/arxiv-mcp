<td id="S5.T5.6.3.2" class="ltx_td ltx_align_center ltx_border_bb" style="padding:1.7pt 8.0pt;"><span id="S5.T5.6.3.2.1" class="ltx_text ltx_font_bold" style="font-size:80%;">95.1</span></td>
