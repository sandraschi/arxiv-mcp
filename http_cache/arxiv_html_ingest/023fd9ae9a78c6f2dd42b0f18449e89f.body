<td id="S5.T7.6.3.2" class="ltx_td ltx_align_center ltx_border_bb" style="padding:1.3pt 4.0pt;"><span id="S5.T7.6.3.2.1" class="ltx_text ltx_font_bold" style="font-size:80%;">62.4</span></td>
