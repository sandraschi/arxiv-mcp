<td id="S5.T5.6.2.4" class="ltx_td ltx_align_center ltx_border_t" style="padding:1.7pt 8.0pt;"><span id="S5.T5.6.2.4.1" class="ltx_text" style="font-size:80%;">47.4</span></td>
