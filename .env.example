# Backend bind (web + MCP HTTP)
ARXIV_MCP_HOST=127.0.0.1
ARXIV_MCP_PORT=10770

# Polite arXiv API pacing (seconds between requests; arXiv recommends ~3)
ARXIV_MCP_CLIENT_DELAY_SECONDS=3.0
# API retry on 429/5xx (exponential backoff inside the client thread)
ARXIV_MCP_ARXIV_MAX_RETRIES=4
ARXIV_MCP_ARXIV_BACKOFF_BASE_SECONDS=3.0
ARXIV_MCP_ARXIV_BACKOFF_MAX_SECONDS=30.0
# fetch_full_text: wall-clock budget for GET+HTML→MD; max HTML bytes before skip
ARXIV_MCP_FETCH_FULL_TEXT_BUDGET_SECONDS=90
ARXIV_MCP_FETCH_FULL_TEXT_MAX_BYTES=8000000
ARXIV_MCP_FETCH_FULL_TEXT_PDF_MAX_CHARS=100000
ARXIV_MCP_HTTP_CACHE_ENABLED=1

# Corpus storage (SQLite + markdown files + LanceDB vectors)
ARXIV_MCP_DATA_DIR=

# Semantic RAG (LanceDB + FastEmbed — install: uv sync --extra rag)
ARXIV_MCP_RAG_ENABLED=1
ARXIV_MCP_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Default depot search: fts | semantic | hybrid
ARXIV_MCP_DEPOT_SEARCH_MODE=hybrid

# Deep epistemic analysis (OpenAI-compatible LLM — Ollama: http://localhost:11434/v1)
ARXIV_MCP_EPISTEMIC_DEEP_ENABLED=1
ARXIV_MCP_SAMPLING_BASE_URL=http://localhost:11434/v1
ARXIV_MCP_SAMPLING_MODEL=llama3.2
ARXIV_MCP_SAMPLING_API_KEY=
ARXIV_MCP_SAMPLING_MAX_TOKENS=2500
ARXIV_MCP_SAMPLING_TIMEOUT_SECONDS=120

# Unpaywall polite pool (required for resolve_doi / fetch_doi_content)
ARXIV_MCP_UNPAYWALL_EMAIL=

# Calibre bridge (optional — store_paper_to_calibre)
# ARXIV_MCP_CALIBRE_LIBRARY_PATH=
# ARXIV_MCP_CALIBREDB_PATH=C:\Program Files\Calibre2\calibredb.exe
# ARXIV_MCP_TEMP_DIR=

# Optional: Semantic Scholar API key (higher rate limits)
ARXIV_MCP_SEMANTIC_SCHOLAR_API_KEY=

# arxiv.org HTML search tools + Jina Reader (getContent)
ARXIV_MCP_ARXIV_HTTP_TIMEOUT_SECONDS=30
ARXIV_MCP_JINA_READER_BASE_URL=https://r.jina.ai

# MCP bridge: comma-separated URLs to proxy additional MCP servers through this one
# MCP_BRIDGE_URLS=http://localhost:10782/mcp,http://localhost:10756/mcp

# ── Code-hunt: track open-weight code/repo drops (esp. PRC labs) ──────────────
# Categories scanned by run_codehunt_scan (FunASR audio = cs.SD).
ARXIV_MCP_CODEHUNT_CATEGORIES=cs.AI,cs.LG,cs.RO,cs.SD
# Always push code drops in these categories (cs.SD = sound/audio, FunASR ecosystem).
ARXIV_MCP_CODEHUNT_PRIORITY_CATEGORIES=cs.SD
# Push China-signal drops + priority categories; skip other Western-only noise.
ARXIV_MCP_CODEHUNT_CHINA_ONLY_PUSH=1
# Max papers per scan to pull full text for (link/promise confirmation).
ARXIV_MCP_CODEHUNT_FULLTEXT_MAX_PAPERS=12
# Per-repo liveness HTTP timeout during re-poll.
ARXIV_MCP_CODEHUNT_REPO_TIMEOUT_SECONDS=12
# aiwatcher-mcp push target for live code-drop alerts (POST /api/fleet/ingest).
# Leave blank to disable cross-talk (digests are still written locally).
ARXIV_MCP_AIWATCHER_BASE_URL=http://localhost:10946
# Set to the SAME value as aiwatcher's AIWATCHER_API_KEY when that auth is enabled.
ARXIV_MCP_AIWATCHER_API_KEY=
# Curated high-signal authors (optional JSON path; default config/codehunt_watch_authors.json).
# ARXIV_MCP_CODEHUNT_WATCH_AUTHORS_FILE=D:/Dev/repos/arxiv-mcp/config/codehunt_watch_authors.json
# Comma-separated names merged into the watchlist (e.g. extra lab leads).
# ARXIV_MCP_CODEHUNT_WATCH_AUTHORS_EXTRA=Ilya Sutskever,Jeff Dean
# Tier-A affiliations: config/codehunt_affiliations.json (Tsinghua, U Tokyo, Anthropic, DeepMind, …)
# ARXIV_MCP_CODEHUNT_AFFILIATIONS_FILE=
# ARXIV_MCP_CODEHUNT_AFFILIATION_MIN_TIER=a
# Media traction (HN + Google News RSS + tech magazine RSS) ~7d after arXiv pub.
# Never scrapes bot-hostile article HTML (Ars Technica etc.) — syndication metadata only.
# ARXIV_MCP_CODEHUNT_MEDIA_ENABLED=1
# ARXIV_MCP_CODEHUNT_MEDIA_MIN_AGE_DAYS=7
# ARXIV_MCP_CODEHUNT_MEDIA_MAX_AGE_DAYS=45
# ARXIV_MCP_CODEHUNT_MEDIA_RECHECK_DAYS=14
# ARXIV_MCP_CODEHUNT_MEDIA_FEEDS_FILE=config/codehunt_media_feeds.json
# ARXIV_MCP_CODEHUNT_MEDIA_FEED_CACHE_HOURS=6
# Opt-in Jina enrichment for bot-blocked publisher URLs (UI toggle overrides at runtime):
# ARXIV_MCP_CODEHUNT_MEDIA_IGNORE_BOTBLOCKS=0
# Bright Hand (Bright Data Web Unlocker) — after Jina fails; billed:
# ARXIV_MCP_CODEHUNT_MEDIA_USE_BRIGHTHAND=0
# BRIGHTDATA_API_TOKEN=          # or ARXIV_MCP_BRIGHTDATA_API_TOKEN
# ARXIV_MCP_BRIGHTDATA_ZONE=web_unlocker1
# Licensed publication subscriptions (NYT, WSJ, FT) — see docs/PUBLICATION_AUTH.md
# ARXIV_MCP_PUB_NYT_USER=
# ARXIV_MCP_PUB_NYT_PASSWORD=
# ARXIV_MCP_PUB_NYT_VALID_TILL=2026-12-31
# ARXIV_MCP_PUB_NYT_COOKIE=
# ARXIV_MCP_PUBLICATION_EXPIRING_WARN_DAYS=7
# Readly cross-connect (readly-mcp on :10863; token lives on readly side)
# ARXIV_MCP_READLY_ENABLED=1
# ARXIV_MCP_READLY_MCP_URL=http://127.0.0.1:10863
# ARXIV_MCP_READLY_VALID_TILL=2026-12-31
# Optional: attach magazine coverage to depot papers on ingest_and_analyze_paper
# ARXIV_MCP_READLY_INGEST_ON_DEPOT=1
# ARXIV_MCP_READLY_INGEST_MAGAZINES=New Scientist,Nature,Scientific American,Wired
# New Scientist web (optional; full issues via Readly):
# ARXIV_MCP_PUB_NEWSCIENTIST_VALID_TILL=
# ARXIV_MCP_PUB_NEWSCIENTIST_COOKIE=
